# ============================================
# Patient data — X-rays & walking videos
# NEVER push real/test patient uploads to a public repo
# ============================================
backend/uploads/xrays/*
backend/uploads/videos/*
!backend/uploads/xrays/.gitkeep
!backend/uploads/videos/.gitkeep

# Generated reports (contain patient data)
backend/reports/
videos
xrays
*.pdf

