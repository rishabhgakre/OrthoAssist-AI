# ============================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ============================================
# Deployment / infra — never commit real credentials
# ============================================
# A kubeconfig pulled down locally while following DEPLOYMENT.md's
# Kubernetes section — grants full cluster access, must never be committed.
kubeconfig
*.kubeconfig
# Local overrides to docker-compose.yml (e.g. real secrets for a one-off
# test) — docker-compose.yml itself has none and is meant to be committed.
docker-compose.override.yml

