# Copy to .env.local for local dev overrides (`cp .env.example .env.local`).
# Not needed for `npm run dev` by default — vite.config.js already proxies
# /api and /uploads to localhost:8000, so this can stay unset locally.
#
# IMPORTANT: Vite bakes this into the built JS at BUILD TIME, not read at
# runtime — on Vercel, set it as a Project → Environment Variable (applies
# at their build step); in Docker, pass it as --build-arg VITE_API_URL=...
# (see frontend/Dockerfile). Changing it always means rebuilding, never
# just restarting.
#
# Example for a deployed backend:
# VITE_API_URL=https://orthoassist-backend.onrender.com
VITE_API_URL=
